{
  "name": "standby-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test test/**/*.test.ts",
    "smoke:production-agents": "node --import tsx scripts/live-production-agents.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^11.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standby.local/contracts/stage-spec.v1.schema.json",
  "title": "STANDBY Stage Spec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "wings",
    "crossover",
    "route_times",
    "minimum_change_ms",
    "initial_state",
    "source_evidence"
  ],
  "properties": {
    "contract_version": { "const": "standby.stage-spec.v1" },
    "wings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["STAGE_RIGHT_WING", "STAGE_LEFT_WING"] }
    },
    "crossover": { "enum": ["AVAILABLE", "UNAVAILABLE", "UNKNOWN"] },
    "route_times": {
      "type": "array",
      "items": { "$ref": "#/$defs/routeTime" }
    },
    "route_capacities": {
      "type": "array",
      "items": { "$ref": "#/$defs/routeCapacity" }
    },
    "minimum_change_ms": { "type": ["integer", "null"], "minimum": 0 },
    "initial_state": {
      "type": "array",
      "items": { "$ref": "#/$defs/entityState" }
    },
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "locator"],
      "properties": {
        "quote": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "zone": {
      "enum": ["STAGE_RIGHT_WING", "STAGE", "STAGE_LEFT_WING", "STAGE_LEFT_CHANGE", "STAGE_RIGHT_CHANGE"]
    },
    "routeTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "min_ms", "max_ms"],
      "properties": {
        "from": { "$ref": "#/$defs/zone" },
        "to": { "$ref": "#/$defs/zone" },
        "min_ms": { "type": "integer", "minimum": 0 },
        "max_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "routeCapacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "capacity"],
      "properties": {
        "route_id": { "type": "string", "minLength": 1 },
        "capacity": { "type": "integer", "minimum": 1 }
      }
    },
    "entityState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "kind", "zone"],
      "properties": {
        "entity_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["PERSON", "PROP"] },
        "zone": { "$ref": "#/$defs/zone" }
      }
    }
  }
}

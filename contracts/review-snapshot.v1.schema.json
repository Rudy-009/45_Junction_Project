{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standby.local/contracts/review-snapshot.v1.schema.json",
  "title": "STANDBY Review Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "snapshot_id",
    "case_id",
    "source_snapshot_digest",
    "fact_snapshot_digest",
    "reviewed_fact_ids",
    "reviewed_link_ids",
    "frozen_by",
    "frozen_at"
  ],
  "properties": {
    "contract_version": { "const": "standby.review-snapshot.v1" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "source_snapshot_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fact_snapshot_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewed_fact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "reviewed_link_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "frozen_by": { "type": "string", "minLength": 1 },
    "frozen_at": { "type": "string", "format": "date-time" }
  }
}

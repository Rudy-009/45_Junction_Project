{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standby.local/contracts/revision.v1.schema.json",
  "title": "STANDBY Revision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "revision_id",
    "case_id",
    "parent_revision_id",
    "base_source_sha256",
    "revision_hash",
    "patches",
    "created_by",
    "created_at"
  ],
  "properties": {
    "contract_version": { "const": "standby.revision.v1" },
    "revision_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "parent_revision_id": { "type": ["string", "null"] },
    "base_source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "patches": {
      "type": "array",
      "items": { "$ref": "#/$defs/cellPatch" }
    },
    "row_operations": {
      "type": "array",
      "items": { "$ref": "#/$defs/rowOperation" }
    },
    "created_by": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "rowOperation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "row_id"],
          "properties": {
            "type": { "const": "DELETE" },
            "row_id": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "after_row_id", "row"],
          "properties": {
            "type": { "const": "ADD" },
            "after_row_id": { "type": "string", "minLength": 1 },
            "row": {
              "type": "object",
              "required": ["id"],
              "properties": { "id": { "type": "string", "minLength": 1 } },
              "additionalProperties": { "type": "string" }
            }
          }
        }
      ]
    },
    "cellPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "column", "from", "to"],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "column": { "type": "string", "minLength": 1 },
        "from": {
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "to": {
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
